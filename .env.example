# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PROJECT_ID=

# Not used by the application. Every query goes through the anon client under
# RLS; there is no code path that reads a service-role key. Only set this if you
# need it for local Supabase CLI tooling.

# Cloudflare R2 (Required for v2+ file uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (Email)
RESEND_API_KEY=
# Production: use an address on your verified Resend domain.
EMAIL_FROM=noreply@yourdomain.com

# Sentry (Error Tracking)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# App
# Production: set to https://yourdomain.com (no trailing slash). Required for OG tags, sitemap, and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

    # CRITICAL IN PRODUCTION: this must be your real, public origin with no
    # trailing slash (e.g. https://travel.example). It is baked into the
    # emailRedirectTo of every signup confirmation, magic link and password
    # reset. Left at localhost, those emails send real users to
    # http://localhost:3000/auth/callback, which is their own laptop, so the
    # link silently never works. Required for OG tags and sitemap too.
NODE_ENV=development

# Auth (optional)
# Set to "demo" to enable in-memory demo auth WITHOUT Supabase
# NEVER use in production - production must reject demo mode even if set
NEXT_PUBLIC_AUTH_MODE=
# ---------------------------------------------------------------------------
# Auth rate limiting (optional overrides)
# ---------------------------------------------------------------------------
# Defaults live in lib/rate-limit.ts and are already reasonable:
#   login          10 / 15 min per IP
#   login_email     5 / 15 min per IP+email
#   signup          5 / hour  per IP
#   signup_email    3 / hour  per IP+email
#   magic           5 / hour  per IP
#   magic_email     3 / hour  per IP+email
#   reset           5 / hour  per IP
#   reset_email     3 / hour  per IP+email
#
# Override only to tune, e.g. a shared NAT or an office IP:
#   RATE_LIMIT_LOGIN=50
#
# IMPORTANT: the default limiter keeps counters in process memory. That is fine
# for local development and a single instance, but on serverless (Vercel) every
# cold start begins empty, so the effective limit is far weaker than the numbers
# above. Swap the store in lib/rate-limit.ts for a shared one (Upstash Redis,
# Vercel KV) before relying on these limits in production.